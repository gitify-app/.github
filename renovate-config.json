{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":enableVulnerabilityAlerts",
    ":semanticCommitTypeAll(chore)",
    ":separateMultipleMajorReleases",
    "schedule:weekly"
  ],
  "labels": ["dependency"],
  "packageRules": [
    {
      "description": "Pin npm dependency ranges by default",
      "matchManagers": ["npm"],
      "rangeStrategy": "pin"
    },
    {
      "description": "Use the dependency name in npm commit messages and PR titles",
      "matchDatasources": ["npm"],
      "commitMessageTopic": "{{depName}}"
    }
  ]
}
